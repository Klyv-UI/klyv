# Headers Cloudflare applies to the built site. Not served itself.
#
# Vite copies public/ into dist-site/, which is the assets directory the
# Worker serves (wrangler.toml).

/*
  # A year of HTTPS, for this host and every subdomain. Safe to preload: the
  # site has never been served over plain HTTP by design.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # No guessing at a file's type from its bytes.
  X-Content-Type-Options: nosniff
  # Framing is what a clickjack needs. The site is never embedded.
  X-Frame-Options: DENY
  # The path is never sent to another origin — only the bare domain.
  Referrer-Policy: strict-origin-when-cross-origin
  # None of these are used, so none are granted.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Every filename under assets/ carries a content hash, so a change is a new
# name and this copy can be kept for a year without a revalidation request.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/og.jpg
  Cache-Control: public, max-age=604800

# Crawler files change with every deploy, so they are checked each time.
/robots.txt
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate

/llms.txt
  Cache-Control: public, max-age=0, must-revalidate

/llms-full.txt
  Cache-Control: public, max-age=0, must-revalidate
