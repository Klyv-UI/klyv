{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Klyv design tokens. Names are stable; the dark mode changes values only.",
  "color": {
    "canvas": {
      "$value": "#f4f7f0",
      "$type": "color",
      "$description": "page behind the app window"
    },
    "shell": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "the app window itself"
    },
    "app": {
      "$value": "#f6f7f4",
      "$type": "color",
      "$description": "content area inside the window"
    },
    "surface": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "cards"
    },
    "surface-muted": {
      "$value": "#f4f5f5",
      "$type": "color",
      "$description": "inner fields / inactive icon tiles"
    },
    "surface-sunken": {
      "$value": "#fafafa",
      "$type": "color",
      "$description": "rate rows, row hover"
    },
    "line": {
      "$value": "#eeefee",
      "$type": "color"
    },
    "line-strong": {
      "$value": "#e3e5e3",
      "$type": "color"
    },
    "track": {
      "$value": "#edefea",
      "$type": "color",
      "$description": "unfilled meter pips"
    },
    "ink": {
      "$value": "#17191c",
      "$type": "color",
      "$description": "primary       — 16.9:1"
    },
    "ink-inverse": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "text *on* ink — flips with the theme"
    },
    "ink-soft": {
      "$value": "#5c6165",
      "$type": "color",
      "$description": "secondary    — 6.2:1"
    },
    "ink-faint": {
      "$value": "#6a7075",
      "$type": "color",
      "$description": "tertiary     — 5.0:1 on surface, 4.6:1 on canvas"
    },
    "focus": {
      "$value": "var(--color-ink)",
      "$type": "color"
    },
    "accent": {
      "$value": "#c8f24e",
      "$type": "color"
    },
    "accent-strong": {
      "$value": "#b9e93a",
      "$type": "color"
    },
    "accent-soft": {
      "$value": "var(--accent-soft-light, #e6fbb0)",
      "$type": "color"
    },
    "accent-ink": {
      "$value": "#16200c",
      "$type": "color"
    },
    "success": {
      "$value": "#2d7135",
      "$type": "color"
    },
    "warning": {
      "$value": "#f5a524",
      "$type": "color"
    },
    "danger": {
      "$value": "#c42630",
      "$type": "color"
    },
    "scrim": {
      "$value": "rgba(20, 24, 18, 0.28)",
      "$type": "color"
    }
  },
  "radius": {
    "2": {
      "$value": "2px",
      "$type": "dimension",
      "$description": "handles, heat cells"
    },
    "3": {
      "$value": "3px",
      "$type": "dimension",
      "$description": "swatches, grid cells"
    },
    "4": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "inline marks, keys"
    },
    "5": {
      "$value": "5px",
      "$type": "dimension",
      "$description": "inline code, small checks"
    },
    "6": {
      "$value": "6px",
      "$type": "dimension",
      "$description": "checkboxes, chips, crumbs"
    },
    "7": {
      "$value": "7px",
      "$type": "dimension",
      "$description": "card brand plate"
    },
    "8": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "compact controls"
    },
    "9": {
      "$value": "9px",
      "$type": "dimension",
      "$description": "small wordmark"
    },
    "10": {
      "$value": "10px",
      "$type": "dimension",
      "$description": "option rows in menus and lists"
    },
    "11": {
      "$value": "11px",
      "$type": "dimension",
      "$description": "medium wordmark"
    },
    "13": {
      "$value": "13px",
      "$type": "dimension",
      "$description": "rail logo"
    },
    "18": {
      "$value": "18px",
      "$type": "dimension",
      "$description": "chat bubbles"
    },
    "glyph": {
      "$value": "12px",
      "$type": "dimension",
      "$description": "icon tiles, rate rows"
    },
    "tile": {
      "$value": "14px",
      "$type": "dimension",
      "$description": "inner tiles, menus"
    },
    "field": {
      "$value": "16px",
      "$type": "dimension",
      "$description": "exchange fields"
    },
    "card": {
      "$value": "20px",
      "$type": "dimension",
      "$description": "cards"
    },
    "banner": {
      "$value": "24px",
      "$type": "dimension",
      "$description": "hero banner"
    },
    "window": {
      "$value": "32px",
      "$type": "dimension",
      "$description": "app window"
    },
    "hair": {
      "$value": "1.5px",
      "$type": "dimension",
      "$description": "signal bars"
    },
    "xs": {
      "$value": "0.125rem",
      "$type": "dimension"
    },
    "sm": {
      "$value": "0.25rem",
      "$type": "dimension"
    },
    "md": {
      "$value": "0.375rem",
      "$type": "dimension"
    },
    "lg": {
      "$value": "0.5rem",
      "$type": "dimension"
    },
    "xl": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "2xl": {
      "$value": "1rem",
      "$type": "dimension"
    },
    "3xl": {
      "$value": "1.5rem",
      "$type": "dimension"
    },
    "4xl": {
      "$value": "2rem",
      "$type": "dimension"
    }
  },
  "shadow": {
    "card": {
      "$value": "0 1px 2px rgba(20, 27, 15, 0.04), 0 8px 24px -12px rgba(20, 27, 15, 0.08)",
      "$type": "shadow"
    },
    "tile": {
      "$value": "0 1px 2px rgba(20, 27, 15, 0.05)",
      "$type": "shadow"
    },
    "float": {
      "$value": "0 4px 16px -4px rgba(20, 27, 15, 0.14), 0 1px 3px rgba(20, 27, 15, 0.06)",
      "$type": "shadow"
    },
    "window": {
      "$value": "0 40px 90px -30px rgba(31, 44, 20, 0.28)",
      "$type": "shadow"
    }
  },
  "$modes": {
    "dark": {
      "color": {
        "canvas": "#0b0d0a",
        "shell": "#121511",
        "app": "#101310",
        "surface": "#161a14",
        "surface-muted": "#1e231b",
        "surface-sunken": "#12160f",
        "line": "#262c22",
        "line-strong": "#333a2d",
        "track": "#232820",
        "ink": "#edf0e8",
        "ink-soft": "#a3aa9b",
        "ink-faint": "#868d80",
        "ink-inverse": "#0b0d0a",
        "scrim": "rgba(0, 0, 0, 0.62)",
        "accent-soft": "var(--accent-soft-dark, #1f2a10)",
        "success": "#56b863",
        "warning": "#f7b23f",
        "danger": "#f2686c"
      }
    }
  }
}
