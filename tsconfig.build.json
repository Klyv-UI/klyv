{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "dist",
    "rootDir": "src",
    "allowImportingTsExtensions": false,
    "types": ["vite/client"]
  },
  "include": ["src/index.ts", "src/components", "src/lib", "src/theme", "src/tokens", "src/styles"],
  "exclude": ["src/site", "src/main.tsx"]
}
