{
  "props": [
    {
      "name": "steps",
      "type": "StepperStep[]",
      "required": true,
      "description": "The steps, in order."
    },
    {
      "name": "current",
      "type": "number",
      "required": true,
      "description": "Index of the current step, zero-based."
    },
    {
      "name": "orientation",
      "type": "'horizontal' | 'vertical'",
      "required": false,
      "defaultValue": "'horizontal'"
    },
    {
      "name": "onStepSelect",
      "type": "(index: number) => void",
      "required": false,
      "description": "Let the user jump to a completed step."
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "defaultValue": "'Progress'",
      "description": "Accessible name for the sequence."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
