{
  "props": [
    {
      "name": "entrants",
      "type": "string[]",
      "required": true,
      "description": "Entrants in seed order: the first is the top seed."
    },
    {
      "name": "format",
      "type": "TournamentBracketFormat",
      "required": false,
      "defaultValue": "'single'",
      "description": "Single elimination, or double with a losers' bracket and a grand final that can reset."
    },
    {
      "name": "results",
      "type": "TournamentBracketResults",
      "required": false,
      "description": "Controlled results, keyed by match id."
    },
    {
      "name": "defaultResults",
      "type": "TournamentBracketResults",
      "required": false,
      "defaultValue": "{}",
      "description": "Results when uncontrolled."
    },
    {
      "name": "onResultsChange",
      "type": "(results: TournamentBracketResults) => void",
      "required": false
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Accessible name for the bracket."
    },
    {
      "name": "readOnly",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Show results without score inputs."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
