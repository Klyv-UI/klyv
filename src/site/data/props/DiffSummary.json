{
  "props": [
    {
      "name": "changes",
      "type": "FieldChange[]",
      "required": true
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Accessible name."
    },
    {
      "name": "onRevert",
      "type": "(field: string) => void",
      "required": false,
      "description": "Put a single field back."
    },
    {
      "name": "emptyLabel",
      "type": "string",
      "required": false,
      "defaultValue": "'Nothing has changed yet.'",
      "description": "Copy shown when nothing has changed."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
