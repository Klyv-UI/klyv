{
  "props": [
    {
      "name": "page",
      "type": "number",
      "required": true,
      "description": "Current page, one-based."
    },
    {
      "name": "pageCount",
      "type": "number",
      "required": true,
      "description": "Total number of pages."
    },
    {
      "name": "onPageChange",
      "type": "(page: number) => void",
      "required": true
    },
    {
      "name": "siblings",
      "type": "number",
      "required": false,
      "defaultValue": "1",
      "description": "How many numbered buttons to show around the current page."
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "defaultValue": "'Pagination'",
      "description": "Accessible name for the control."
    },
    {
      "name": "compact",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Show a compact form with only the arrows and a counter."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
