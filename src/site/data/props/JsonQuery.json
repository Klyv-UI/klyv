{
  "props": [
    {
      "name": "data",
      "type": "unknown",
      "required": true,
      "description": "The document to query."
    },
    {
      "name": "value",
      "type": "string",
      "required": false,
      "description": "Controlled JSONPath expression."
    },
    {
      "name": "defaultValue",
      "type": "string",
      "required": false,
      "defaultValue": "'$'",
      "description": "Starting expression when uncontrolled."
    },
    {
      "name": "onValueChange",
      "type": "(value: string) => void",
      "required": false,
      "description": "Called with the expression after every edit."
    },
    {
      "name": "onResultsChange",
      "type": "(results: JsonQueryResult[]) => void",
      "required": false,
      "description": "Called with the matches whenever the expression evaluates cleanly."
    },
    {
      "name": "examples",
      "type": "string[]",
      "required": false,
      "defaultValue": "[]",
      "description": "Ready-made expressions offered under the field."
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "defaultValue": "'JSONPath'",
      "description": "Visible label for the expression field."
    },
    {
      "name": "maxResults",
      "type": "number",
      "required": false,
      "defaultValue": "200",
      "description": "Most results listed; the tree still marks every match."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
