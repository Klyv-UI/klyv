{
  "props": [
    {
      "name": "groups",
      "type": "SidebarGroup<T>[]",
      "required": true
    },
    {
      "name": "value",
      "type": "T",
      "required": true
    },
    {
      "name": "onValueChange",
      "type": "(value: T) => void",
      "required": true
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "defaultValue": "'Sections'",
      "description": "Accessible name for the navigation."
    },
    {
      "name": "footer",
      "type": "React.ReactNode",
      "required": false,
      "description": "Pinned to the bottom, above any footer content."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
