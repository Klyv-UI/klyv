{
  "props": [
    {
      "name": "value",
      "type": "string",
      "required": false,
      "description": "Controlled text."
    },
    {
      "name": "defaultValue",
      "type": "string",
      "required": false,
      "defaultValue": "''",
      "description": "Starting text when uncontrolled."
    },
    {
      "name": "onValueChange",
      "type": "(value: string) => void",
      "required": false,
      "description": "Called on every edit."
    },
    {
      "name": "targetGrade",
      "type": "number",
      "required": false,
      "defaultValue": "8",
      "description": "Grade to aim for; the summary says whether the text meets it."
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "defaultValue": "'Draft'",
      "description": "Visible label of the text field."
    },
    {
      "name": "rows",
      "type": "number",
      "required": false,
      "defaultValue": "8",
      "description": "Height of the field in text rows."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
