{
  "props": [
    {
      "name": "participants",
      "type": "Participant[]",
      "required": true
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Accessible name for the group."
    },
    {
      "name": "max",
      "type": "number",
      "required": false,
      "defaultValue": "5",
      "description": "Avatars shown before the rest collapse into a count."
    },
    {
      "name": "size",
      "type": "'sm' | 'md'",
      "required": false,
      "defaultValue": "'md'"
    },
    {
      "name": "announce",
      "type": "boolean",
      "required": false,
      "defaultValue": "true",
      "description": "Announce arrivals and departures through a live region."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
