{
  "props": [
    {
      "name": "dimensions",
      "type": "ParallelCoordinatesDimension[]",
      "required": true
    },
    {
      "name": "records",
      "type": "ParallelCoordinatesRecord[]",
      "required": true
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Accessible name for the chart."
    },
    {
      "name": "height",
      "type": "number",
      "required": false,
      "defaultValue": "300",
      "description": "Plot height in pixels. The width fills the container."
    },
    {
      "name": "order",
      "type": "string[]",
      "required": false,
      "description": "Axis keys, left to right. Controlled."
    },
    {
      "name": "defaultOrder",
      "type": "string[]",
      "required": false,
      "description": "Initial axis order when uncontrolled. Defaults to the dimensions’ order."
    },
    {
      "name": "onOrderChange",
      "type": "(order: string[]) => void",
      "required": false,
      "description": "Called with the new order after a drag or Arrow key move."
    },
    {
      "name": "brushes",
      "type": "ParallelCoordinatesBrushes",
      "required": false,
      "description": "Active brushes. Controlled."
    },
    {
      "name": "defaultBrushes",
      "type": "ParallelCoordinatesBrushes",
      "required": false,
      "defaultValue": "{}",
      "description": "Initial brushes when uncontrolled."
    },
    {
      "name": "onBrushesChange",
      "type": "(brushes: ParallelCoordinatesBrushes) => void",
      "required": false,
      "description": "Called whenever a brush is drawn, moved or cleared."
    },
    {
      "name": "noun",
      "type": "string",
      "required": false,
      "defaultValue": "'record'",
      "description": "What a record is called in the count — “team”, “car”."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
