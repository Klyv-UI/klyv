{
  "props": [
    {
      "name": "entries",
      "type": "ActivityEntry[]",
      "required": true
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Accessible name for the feed."
    },
    {
      "name": "format",
      "type": "(amount: number) => string",
      "required": false,
      "defaultValue": "(amount) => `${amount < 0 ? '-' : '+'}$${Math.abs(amount).toFixed(2)}`",
      "description": "Format an amount for display."
    },
    {
      "name": "showDailyTotals",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Show a running total per day group."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
