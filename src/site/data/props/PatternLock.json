{
  "props": [
    {
      "name": "size",
      "type": "number",
      "required": false,
      "defaultValue": "3",
      "description": "Dots per side."
    },
    {
      "name": "minLength",
      "type": "number",
      "required": false,
      "defaultValue": "4",
      "description": "Fewest dots a pattern may have. Shorter ones are refused with a message."
    },
    {
      "name": "onComplete",
      "type": "(pattern: number[]) => boolean | void | Promise<boolean | void>",
      "required": false,
      "description": "Called with the dot indices (row by row, from 0) when a pattern is finished. Return or resolve true for success, false for a wrong pattern."
    },
    {
      "name": "status",
      "type": "PatternLockStatus",
      "required": false,
      "description": "Forces the state from outside, for patterns checked elsewhere."
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "defaultValue": "'Unlock pattern'",
      "description": "Accessible name."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Blocks drawing."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
