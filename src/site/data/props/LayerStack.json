{
  "props": [
    {
      "name": "layers",
      "type": "StackLayer[]",
      "required": true,
      "description": "Bottom of the stack first, so the array reads like the diagram."
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Accessible name for the diagram."
    },
    {
      "name": "separation",
      "type": "number",
      "required": false,
      "defaultValue": "58",
      "description": "Vertical gap between plates, in pixels."
    },
    {
      "name": "lift",
      "type": "number",
      "required": false,
      "defaultValue": "26",
      "description": "Extra lift the selected plate takes, in pixels."
    },
    {
      "name": "width",
      "type": "number",
      "required": false,
      "defaultValue": "300",
      "description": "Plate width in pixels."
    },
    {
      "name": "value",
      "type": "string",
      "required": false,
      "description": "Selected layer id. Omit for uncontrolled."
    },
    {
      "name": "onValueChange",
      "type": "(id: string) => void",
      "required": false
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
