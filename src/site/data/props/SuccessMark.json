{
  "props": [
    {
      "name": "size",
      "type": "SuccessMarkSize",
      "required": false,
      "defaultValue": "'md'"
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "defaultValue": "'Done'",
      "description": "Announced when it appears."
    },
    {
      "name": "bare",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Draw the tick only, without the accent disc behind it."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
