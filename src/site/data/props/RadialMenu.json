{
  "props": [
    {
      "name": "actions",
      "type": "RadialAction[]",
      "required": true
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Accessible name for the trigger."
    },
    {
      "name": "icon",
      "type": "IconComponent",
      "required": true,
      "description": "Trigger glyph."
    },
    {
      "name": "radius",
      "type": "number",
      "required": false,
      "defaultValue": "92",
      "description": "Distance from the centre to each action, in pixels."
    },
    {
      "name": "startAngle",
      "type": "number",
      "required": false,
      "defaultValue": "-90",
      "description": "Degrees. 0 points right, -90 points up."
    },
    {
      "name": "sweep",
      "type": "number",
      "required": false,
      "defaultValue": "180",
      "description": "Degrees the actions are spread across. 360 makes a full wheel."
    },
    {
      "name": "open",
      "type": "boolean",
      "required": false
    },
    {
      "name": "onOpenChange",
      "type": "(open: boolean) => void",
      "required": false
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
