{
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "description": "What is underneath. Rendered immediately; the cover hides it."
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "defaultValue": "'Scratch to reveal'",
      "description": "Prompt drawn on the cover."
    },
    {
      "name": "cover",
      "type": "string",
      "required": false,
      "defaultValue": "'linear-gradient(135deg, var(--color-line-strong) 0%, var(--color-surface-muted) 45%, var(--color-line) 100%)'",
      "description": "Cover colour, or any CSS gradient."
    },
    {
      "name": "brush",
      "type": "number",
      "required": false,
      "defaultValue": "26",
      "description": "Brush radius in pixels."
    },
    {
      "name": "threshold",
      "type": "number",
      "required": false,
      "defaultValue": "0.45",
      "description": "Fraction cleared before it reveals the rest, 0–1."
    },
    {
      "name": "revealed",
      "type": "boolean",
      "required": false,
      "description": "Reveal it from the outside — a \"reveal all\" control elsewhere."
    },
    {
      "name": "onReveal",
      "type": "() => void",
      "required": false
    },
    {
      "name": "revealLabel",
      "type": "string",
      "required": false,
      "defaultValue": "'Reveal'",
      "description": "Text for the keyboard fallback control."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
