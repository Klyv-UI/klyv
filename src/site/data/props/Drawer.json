{
  "props": [
    {
      "name": "open",
      "type": "boolean",
      "required": true,
      "description": "Whether the dialog is showing."
    },
    {
      "name": "onClose",
      "type": "() => void",
      "required": true,
      "description": "Called on cancel, on Escape, and on a backdrop click."
    },
    {
      "name": "title",
      "type": "string",
      "required": true,
      "description": "Visible title. Becomes the accessible name."
    },
    {
      "name": "children",
      "type": "ReactNode",
      "required": false,
      "description": "The panel body."
    },
    {
      "name": "footer",
      "type": "ReactNode",
      "required": false
    },
    {
      "name": "side",
      "type": "DrawerSide",
      "required": false,
      "defaultValue": "'left'"
    },
    {
      "name": "bare",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Hide the header entirely; supply your own inside children."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
