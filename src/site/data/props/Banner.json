      "required": false,
      "defaultValue": "'accent'"
    },
    {
      "name": "title",
      "type": "string",
      "required": true,
      "description": "Heading for the message."
    },
    {
      "name": "children",
      "type": "ReactNode",
      "required": false,
      "description": "The message body."
    },
    {
      "name": "icon",
      "type": "IconComponent",
      "required": false,
      "description": "Glyph before the message."
    },
    {
      "name": "action",
