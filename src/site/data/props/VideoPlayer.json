{
  "props": [
    {
      "name": "src",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true,
      "description": "Accessible name for the player — the video's title."
    },
    {
      "name": "poster",
      "type": "string",
      "required": false,
      "description": "Image shown before playback starts."
    },
    {
      "name": "tracks",
      "type": "VideoPlayerTrack[]",
      "required": false,
      "defaultValue": "[]",
      "description": "Caption and subtitle files (WebVTT)."
    },
    {
      "name": "rates",
      "type": "number[]",
      "required": false,
      "defaultValue": "[0.5, 0.75, 1, 1.25, 1.5, 2]",
      "description": "Speeds offered in the speed menu."
    },
    {
      "name": "skip",
      "type": "number",
      "required": false,
      "defaultValue": "10",
      "description": "Seconds that J and L skip."
    },
    {
      "name": "loop",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Loop at the end."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
