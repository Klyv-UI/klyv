{
  "props": [
    {
      "name": "groups",
      "type": "KaplanMeierChartGroup[]",
      "required": true,
      "description": "One curve per group."
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Accessible name for the chart."
    },
    {
      "name": "confidence",
      "type": "0.9 | 0.95 | 0.99",
      "required": false,
      "defaultValue": "0.95",
      "description": "Coverage of the confidence band."
    },
    {
      "name": "showConfidence",
      "type": "boolean",
      "required": false,
      "defaultValue": "true",
      "description": "Shade the confidence band around each curve."
    },
    {
      "name": "showCensors",
      "type": "boolean",
      "required": false,
      "defaultValue": "true",
      "description": "Tick each censored subject on its curve."
    },
    {
      "name": "showMedian",
      "type": "boolean",
      "required": false,
      "defaultValue": "true",
      "description": "Mark where each curve crosses 50%."
    },
    {
      "name": "showAtRisk",
      "type": "boolean",
      "required": false,
      "defaultValue": "true",
      "description": "Print the number at risk under each axis tick."
    },
    {
      "name": "timeLabel",
      "type": "string",
      "required": false,
      "description": "Name of the time unit, printed under the axis — days, months."
    },
    {
      "name": "formatTime",
      "type": "(value: number) => string",
      "required": false,
      "defaultValue": "formatTick",
      "description": "Format times on the axis and in the tooltip."
    },
    {
      "name": "height",
      "type": "number",
      "required": false,
      "defaultValue": "260",
      "description": "Plot height in pixels, not counting the at-risk table."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
