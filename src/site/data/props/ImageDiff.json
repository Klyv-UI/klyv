{
  "props": [
    {
      "name": "before",
      "type": "string",
      "required": true,
      "description": "The baseline image URL. Cross-origin images need CORS headers for their pixels to be readable."
    },
    {
      "name": "after",
      "type": "string",
      "required": true,
      "description": "The candidate image URL, compared at the baseline’s size."
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Accessible name for the comparison."
    },
    {
      "name": "threshold",
      "type": "number",
      "required": false,
      "defaultValue": "0.1",
      "description": "0 to 1. How different two pixels must be, perceptually, to count as changed."
    },
    {
      "name": "mode",
      "type": "ImageDiffMode",
      "required": false,
      "description": "Controlled view."
    },
    {
      "name": "defaultMode",
      "type": "ImageDiffMode",
      "required": false,
      "defaultValue": "'diff'",
      "description": "Initial view when uncontrolled."
    },
    {
      "name": "onModeChange",
      "type": "(mode: ImageDiffMode) => void",
      "required": false
    },
    {
      "name": "beforeLabel",
      "type": "string",
      "required": false,
      "defaultValue": "'Before'"
    },
    {
      "name": "afterLabel",
      "type": "string",
      "required": false,
      "defaultValue": "'After'"
    },
    {
      "name": "onDiff",
      "type": "(result: ImageDiffResult) => void",
      "required": false,
      "description": "Called once the images are compared."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
