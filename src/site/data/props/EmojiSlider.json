{
  "props": [
    {
      "name": "value",
      "type": "number",
      "required": true
    },
    {
      "name": "onChange",
      "type": "(value: number) => void",
      "required": true
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "What is being rated."
    },
    {
      "name": "faces",
      "type": "string[]",
      "required": false,
      "defaultValue": "FACES",
      "description": "Worst to best. The scale is split evenly between them."
    },
    {
      "name": "words",
      "type": "string[]",
      "required": false,
      "defaultValue": "WORDS",
      "description": "Words for each face, announced instead of the number."
    },
    {
      "name": "min",
      "type": "number",
      "required": false,
      "defaultValue": "0",
      "description": "Lowest value."
    },
    {
      "name": "max",
      "type": "number",
      "required": false,
      "defaultValue": "100",
      "description": "Highest value."
    },
    {
      "name": "scaleWithValue",
      "type": "boolean",
      "required": false,
      "defaultValue": "true",
      "description": "Grow the emoji as it improves."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
