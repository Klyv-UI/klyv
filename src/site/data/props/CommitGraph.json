{
  "props": [
    {
      "name": "commits",
      "type": "CommitGraphCommit[]",
      "required": true,
      "description": "Newest first, parents after their children — the order `git log --topo-order` prints."
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Accessible name for the list."
    },
    {
      "name": "value",
      "type": "string | null",
      "required": false,
      "description": "Selected commit hash. Controlled."
    },
    {
      "name": "defaultValue",
      "type": "string | null",
      "required": false,
      "defaultValue": "null",
      "description": "Initially selected hash when uncontrolled."
    },
    {
      "name": "onValueChange",
      "type": "(hash: string, commit: CommitGraphCommit) => void",
      "required": false,
      "description": "Called when the selection moves, by click or arrow key."
    },
    {
      "name": "maxHeight",
      "type": "number",
      "required": false,
      "defaultValue": "440",
      "description": "Height of the scrolling list in pixels."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
