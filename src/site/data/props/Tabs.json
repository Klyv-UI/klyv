{
  "props": [
    {
      "name": "items",
      "type": "TabItem<T>[]",
      "required": true
    },
    {
      "name": "value",
      "type": "T",
      "required": true
    },
    {
      "name": "onValueChange",
      "type": "(value: T) => void",
      "required": true
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Accessible name for the tab list."
    },
    {
      "name": "variant",
      "type": "TabsVariant",
      "required": false,
      "defaultValue": "'pill'"
    },
    {
      "name": "fullWidth",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Stretch the tabs to fill the width."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
