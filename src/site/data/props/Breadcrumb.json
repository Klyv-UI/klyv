{
  "props": [
    {
      "name": "items",
      "type": "BreadcrumbItem[]",
      "required": true
    },
    {
      "name": "maxItems",
      "type": "number",
      "required": false,
      "defaultValue": "4",
      "description": "Collapse the middle when there are more than this many."
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "defaultValue": "'Breadcrumb'",
      "description": "Accessible name for the trail."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
