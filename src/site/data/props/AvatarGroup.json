{
  "props": [
    {
      "name": "people",
      "type": "{ name: string; src?: string }[]",
      "required": true,
      "description": "People, in display order."
    },
    {
      "name": "max",
      "type": "number",
      "required": false,
      "defaultValue": "4",
      "description": "How many to draw before collapsing the rest into a count."
    },
    {
      "name": "size",
      "type": "AvatarSize",
      "required": false,
      "defaultValue": "'sm'"
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "description": "Accessible name for the group."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
