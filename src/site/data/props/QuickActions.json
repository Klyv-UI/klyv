{
  "props": [
    {
      "name": "actions",
      "type": "QuickAction[]",
      "required": true
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "defaultValue": "'Quick actions'",
      "description": "Accessible name for the group."
    },
    {
      "name": "shortcuts",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Register the shortcuts on the document."
    },
    {
      "name": "modifier",
      "type": "'meta' | 'alt' | 'none'",
      "required": false,
      "defaultValue": "'meta'",
      "description": "Modifier the shortcuts require."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
