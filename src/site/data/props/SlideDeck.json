{
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "required": false,
      "description": "SlideDeckSlide elements, one per slide."
    },
    {
      "name": "markdown",
      "type": "string",
      "required": false,
      "description": "Or: slides as text, separated by `---`. `#` and `##` headings, `-` bullets, `>` quotes, **bold**, `code`; notes after a line reading `Note:`."
    },
    {
      "name": "index",
      "type": "number",
      "required": false,
      "description": "Controlled slide index, from 0."
    },
    {
      "name": "defaultIndex",
      "type": "number",
      "required": false,
      "defaultValue": "0",
      "description": "Starting slide when uncontrolled."
    },
    {
      "name": "onIndexChange",
      "type": "(index: number) => void",
      "required": false,
      "description": "Called with the new index on every move."
    },
    {
      "name": "hash",
      "type": "string | false",
      "required": false,
      "defaultValue": "'slide'",
      "description": "Keep the slide in the URL as `#<hash>-3`. Pass false when a page holds more than one deck."
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "defaultValue": "'Presentation'",
      "description": "Accessible name of the deck."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
