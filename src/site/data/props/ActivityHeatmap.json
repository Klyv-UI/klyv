{
  "props": [
    {
      "name": "days",
      "type": "HeatmapDay[]",
      "required": true
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Accessible name for the grid."
    },
    {
      "name": "weeks",
      "type": "number",
      "required": false,
      "defaultValue": "26",
      "description": "Number of weeks to show, counting back from the last day supplied."
    },
    {
      "name": "format",
      "type": "(value: number, date: string) => string",
      "required": false,
      "defaultValue": "(value) => `${value} transactions`",
      "description": "Turn a value into tooltip text."
    },
    {
      "name": "steps",
      "type": "number",
      "required": false,
      "defaultValue": "5",
      "description": "Buckets for the colour ramp. Values are placed by quantile."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
