{
  "props": [
    {
      "name": "value",
      "type": "string",
      "required": false,
      "description": "Time as a 24-hour HH:mm string."
    },
    {
      "name": "onValueChange",
      "type": "(value: string) => void",
      "required": true
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Accessible name."
    },
    {
      "name": "step",
      "type": "15 | 30 | 60",
      "required": false,
      "defaultValue": "30",
      "description": "Minutes between options."
    },
    {
      "name": "min",
      "type": "string",
      "required": false,
      "description": "Earliest and latest selectable times, as HH:mm."
    },
    {
      "name": "max",
      "type": "string",
      "required": false
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "defaultValue": "'Choose a time'",
      "description": "Shown while the field is empty."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Blocks interaction and dims the control."
    },
    {
      "name": "id",
      "type": "string",
      "required": false,
      "description": "Overrides the generated id. Useful when a label lives elsewhere."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
