{
  "props": [
    {
      "name": "open",
      "type": "boolean",
      "required": true
    },
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "description": "Content revealed when open."
    },
    {
      "name": "duration",
      "type": "number",
      "required": false,
      "defaultValue": "220",
      "description": "Transition length in milliseconds."
    },
    {
      "name": "id",
      "type": "string",
      "required": false,
      "description": "Id, so a trigger can point at it with aria-controls."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
