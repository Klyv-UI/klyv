{
  "props": [
    {
      "name": "front",
      "type": "ReactNode",
      "required": true
    },
    {
      "name": "back",
      "type": "ReactNode",
      "required": true
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Accessible name for the toggle, e.g. \"Card details\"."
    },
    {
      "name": "flipped",
      "type": "boolean",
      "required": false,
      "description": "Controlled flip state."
    },
    {
      "name": "onFlippedChange",
      "type": "(flipped: boolean) => void",
      "required": false,
      "description": "Called when the card turns. Pair with `flipped` to control it."
    },
    {
      "name": "axis",
      "type": "'y' | 'x'",
      "required": false,
      "defaultValue": "'y'"
    },
    {
      "name": "height",
      "type": "number",
      "required": false,
      "defaultValue": "200",
      "description": "Fixed height. A flip card needs one, since both faces are stacked."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
