{
  "props": [
    {
      "name": "items",
      "type": "AnchorNavItem[]",
      "required": true
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "defaultValue": "'On this page'",
      "description": "Accessible name for the list."
    },
    {
      "name": "offset",
      "type": "number",
      "required": false,
      "defaultValue": "96",
      "description": "Offset from the top when deciding which section is current, in pixels."
    },
    {
      "name": "orientation",
      "type": "'vertical' | 'horizontal'",
      "required": false,
      "defaultValue": "'vertical'"
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
