{
  "props": [
    {
      "name": "open",
      "type": "boolean",
      "required": true
    },
    {
      "name": "onClose",
      "type": "() => void",
      "required": true
    },
    {
      "name": "commands",
      "type": "Command[]",
      "required": true
    },
    {
      "name": "filter",
      "type": "(commands: Command[], query: string) => Command[]",
      "required": false,
      "description": "Replace the built-in matching. Receives every command and the raw query, and returns the ones to show in the order to show them; groups appear in the order their first command does."
    },
    {
      "name": "query",
      "type": "string",
      "required": false,
      "description": "Control the query from outside. Leave unset and the palette keeps its own."
    },
    {
      "name": "onQueryChange",
      "type": "(query: string) => void",
      "required": false
    },
    {
      "name": "loading",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "The commands are still arriving. Shown in place of the empty state."
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "defaultValue": "'Search commands'",
      "description": "Placeholder for the search field."
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "defaultValue": "'Command palette'",
      "description": "Accessible name for the dialog."
    },
    {
      "name": "emptyMessage",
      "type": "string",
      "required": false,
      "defaultValue": "'No commands match'",
      "description": "Shown when nothing matches."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
