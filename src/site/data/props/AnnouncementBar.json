{
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "description": "One sentence."
    },
    {
      "name": "badge",
      "type": "string",
      "required": false,
      "description": "Short qualifier in front — \"New\"."
    },
    {
      "name": "href",
      "type": "string",
      "required": false,
      "description": "Where the announcement leads."
    },
    {
      "name": "linkLabel",
      "type": "string",
      "required": false,
      "description": "Text of the `href` link."
    },
    {
      "name": "tone",
      "type": "AnnouncementTone",
      "required": false,
      "description": "Surface colour. `muted` maps to Banner's `neutral`."
    },
    {
      "name": "onDismiss",
      "type": "() => void",
      "required": false,
      "description": "Called when the bar is dismissed."
    },
    {
      "name": "storageKey",
      "type": "string",
      "required": false,
      "description": "Remember the dismissal in this browser under this key. Change the key for the next announcement."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
