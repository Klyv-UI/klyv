{
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "description": "The element that reveals the card."
    },
    {
      "name": "content",
      "type": "ReactNode",
      "required": true,
      "description": "Card contents. Richer than a Tooltip: headings, avatars, actions."
    },
    {
      "name": "placement",
      "type": "PopoverPlacement",
      "required": false,
      "defaultValue": "'bottom'"
    },
    {
      "name": "align",
      "type": "PopoverAlign",
      "required": false,
      "defaultValue": "'start'"
    },
    {
      "name": "openDelay",
      "type": "number",
      "required": false,
      "defaultValue": "300",
      "description": "Delay before opening."
    },
    {
      "name": "closeDelay",
      "type": "number",
      "required": false,
      "defaultValue": "180",
      "description": "Grace period before closing, so the pointer can travel to the card."
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "description": "Accessible name for the card."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
