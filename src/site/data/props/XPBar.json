{
  "props": [
    {
      "name": "level",
      "type": "number",
      "required": true,
      "description": "Current level."
    },
    {
      "name": "xp",
      "type": "number",
      "required": true,
      "description": "Points into this level."
    },
    {
      "name": "needed",
      "type": "number",
      "required": true,
      "description": "Points needed to finish it."
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "defaultValue": "'Level'",
      "description": "Name for the thing being levelled."
    },
    {
      "name": "onLevelUp",
      "type": "(level: number) => void",
      "required": false,
      "description": "Fired when a change carries the bar past the end."
    },
    {
      "name": "celebrate",
      "type": "boolean",
      "required": false,
      "defaultValue": "true",
      "description": "Sparks on a level-up."
    },
    {
      "name": "size",
      "type": "'sm' | 'md'",
      "required": false,
      "defaultValue": "'md'"
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
