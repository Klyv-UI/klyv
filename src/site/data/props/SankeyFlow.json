{
  "props": [
    {
      "name": "nodes",
      "type": "FlowNode[]",
      "required": true
    },
    {
      "name": "links",
      "type": "FlowLink[]",
      "required": true
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Accessible name — what is flowing."
    },
    {
      "name": "width",
      "type": "number",
      "required": false,
      "defaultValue": "640",
      "description": "Diagram width. It scrolls horizontally when it does not fit."
    },
    {
      "name": "height",
      "type": "number",
      "required": false,
      "defaultValue": "300",
      "description": "Diagram height."
    },
    {
      "name": "nodeWidth",
      "type": "number",
      "required": false,
      "defaultValue": "12",
      "description": "Node bar width in pixels."
    },
    {
      "name": "nodePadding",
      "type": "number",
      "required": false,
      "defaultValue": "14",
      "description": "Minimum gap between nodes in a column, in pixels."
    },
    {
      "name": "format",
      "type": "(value: number) => string",
      "required": false,
      "defaultValue": "(value) => String(value)"
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
