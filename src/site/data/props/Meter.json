    },
    {
      "name": "variant",
      "type": "MeterVariant",
      "required": false,
      "defaultValue": "'segments'"
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
