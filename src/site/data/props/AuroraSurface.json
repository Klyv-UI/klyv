{
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "required": false,
      "description": "Content laid over the aurora."
    },
    {
      "name": "colors",
      "type": "[string, string, string]",
      "required": false,
      "defaultValue": "['var(--color-accent)', '#7fd4ff', 'var(--color-accent-soft)']",
      "description": "Three colours, one per blob. Defaults to the accent family."
    },
    {
      "name": "intensity",
      "type": "AuroraIntensity",
      "required": false,
      "defaultValue": "'medium'"
    },
    {
      "name": "grain",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Overlay a fine grain so the gradient never bands on wide screens."
    },
    {
      "name": "paused",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Freeze the blobs where they are."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    },
    {
      "name": "contentClassName",
      "type": "string",
      "required": false,
      "description": "Classes for the content layer above the light."
    },
    {
      "name": "as",
      "type": "E",
      "required": false,
      "description": "Element to render."
    }
  ],
  "inherits": [
    "Omit<ComponentPropsWithoutRef<E>, keyof AuroraSurfaceOwnProps | 'as'>"
  ]
}
