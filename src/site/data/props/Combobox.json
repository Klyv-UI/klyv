{
  "props": [
    {
      "name": "options",
      "type": "SelectOption<T>[]",
      "required": true
    },
    {
      "name": "value",
      "type": "T | null",
      "required": true
    },
    {
      "name": "onValueChange",
      "type": "(value: T | null) => void",
      "required": true
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Accessible name."
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "defaultValue": "'Search'",
      "description": "Shown while the field is empty."
    },
    {
      "name": "emptyMessage",
      "type": "string",
      "required": false,
      "defaultValue": "'No matches'",
      "description": "Shown when the query matches nothing."
    },
    {
      "name": "invalid",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Marks the field as failing validation. Pair it with a message."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Blocks interaction and dims the control."
    },
    {
      "name": "id",
      "type": "string",
      "required": false,
      "description": "Overrides the generated id. Useful when a label lives elsewhere."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
