{
  "props": [
    {
      "name": "nodes",
      "type": "TreeNode[]",
      "required": true
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Accessible name for the tree."
    },
    {
      "name": "defaultExpanded",
      "type": "string[]",
      "required": false,
      "defaultValue": "[]",
      "description": "Ids expanded on first render."
    },
    {
      "name": "selected",
      "type": "string",
      "required": false
    },
    {
      "name": "onSelect",
      "type": "(id: string) => void",
      "required": false
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
