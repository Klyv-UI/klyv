{
  "props": [
    {
      "name": "value",
      "type": "MindMapNode",
      "required": false,
      "description": "Controlled tree."
    },
    {
      "name": "defaultValue",
      "type": "MindMapNode",
      "required": false,
      "description": "Tree when uncontrolled."
    },
    {
      "name": "onValueChange",
      "type": "(value: MindMapNode) => void",
      "required": false,
      "description": "Called with the whole new tree after every edit."
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Accessible name for the map."
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "defaultValue": "'New idea'",
      "description": "Text given to a new node before it is renamed."
    },
    {
      "name": "readOnly",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Show the map without editing. Navigation and collapsing still work."
    },
    {
      "name": "height",
      "type": "number",
      "required": false,
      "defaultValue": "420",
      "description": "Height of the canvas in pixels."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
