{
  "props": [
    {
      "name": "title",
      "type": "string",
      "required": true,
      "description": "Visible trigger text."
    },
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "description": "Content revealed when open."
    },
    {
      "name": "defaultOpen",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Uncontrolled starting state."
    },
    {
      "name": "open",
      "type": "boolean",
      "required": false,
      "description": "Controlled state. Pass with onOpenChange."
    },
    {
      "name": "onOpenChange",
      "type": "(open: boolean) => void",
      "required": false
    },
    {
      "name": "meta",
      "type": "ReactNode",
      "required": false,
      "description": "Quiet text on the right of the trigger — a count, a summary."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Blocks interaction and dims the control."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
