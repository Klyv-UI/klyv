{
  "props": [
    {
      "name": "sections",
      "type": "SeatMapSection[]",
      "required": true
    },
    {
      "name": "tiers",
      "type": "SeatMapTier[]",
      "required": true,
      "description": "Up to four tiers, drawn in the accent, success, warning and soft ink colours."
    },
    {
      "name": "value",
      "type": "string[]",
      "required": false,
      "description": "Controlled seat ids."
    },
    {
      "name": "defaultValue",
      "type": "string[]",
      "required": false,
      "defaultValue": "[]",
      "description": "Starting seat ids when uncontrolled."
    },
    {
      "name": "onValueChange",
      "type": "(seats: string[]) => void",
      "required": false,
      "description": "Called with the chosen seat ids after every change."
    },
    {
      "name": "maxSeats",
      "type": "number",
      "required": false,
      "defaultValue": "6",
      "description": "Most seats in one order."
    },
    {
      "name": "noSingleGaps",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Refuse to continue while a choice strands a single empty seat between two taken ones."
    },
    {
      "name": "stageLabel",
      "type": "string",
      "required": false,
      "defaultValue": "'Stage'",
      "description": "Label over the top of the map."
    },
    {
      "name": "currency",
      "type": "string",
      "required": false,
      "defaultValue": "'GBP'",
      "description": "ISO 4217 code for prices."
    },
    {
      "name": "onConfirm",
      "type": "(seats: string[]) => void",
      "required": false,
      "description": "Shows a Continue button, enabled once the choice is valid."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
