{
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "description": "Content that scales while pressed."
    },
    {
      "name": "scale",
      "type": "number",
      "required": false,
      "defaultValue": "0.96",
      "description": "Scale applied while pressed. Keep it subtle."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Blocks interaction and dims the control."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
