{
  "props": [
    {
      "name": "segments",
      "type": "SpinWheelSegment[]",
      "required": true,
      "description": "The prizes or choices, clockwise from the pointer."
    },
    {
      "name": "winner",
      "type": "string",
      "required": false,
      "description": "Land on this segment (by id or label) instead of a weighted random one — for a result decided on the server."
    },
    {
      "name": "onSpinEnd",
      "type": "(segment: SpinWheelSegment, index: number) => void",
      "required": false,
      "description": "Called once the wheel has stopped, with the segment and its index."
    },
    {
      "name": "onSpinStart",
      "type": "() => void",
      "required": false,
      "description": "Called as a spin starts."
    },
    {
      "name": "duration",
      "type": "number",
      "required": false,
      "defaultValue": "4200",
      "description": "Length of a spin, in milliseconds."
    },
    {
      "name": "turns",
      "type": "number",
      "required": false,
      "defaultValue": "5",
      "description": "Whole turns before it settles."
    },
    {
      "name": "size",
      "type": "number",
      "required": false,
      "defaultValue": "300",
      "description": "Diameter in pixels."
    },
    {
      "name": "spinLabel",
      "type": "string",
      "required": false,
      "defaultValue": "'Spin'",
      "description": "Label on the spin button."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Blocks spinning."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
