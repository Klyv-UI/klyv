{
  "props": [
    {
      "name": "value",
      "type": "string",
      "required": false,
      "description": "Controlled source text."
    },
    {
      "name": "defaultValue",
      "type": "string",
      "required": false,
      "defaultValue": "''",
      "description": "Starting text when uncontrolled."
    },
    {
      "name": "onValueChange",
      "type": "(value: string) => void",
      "required": false,
      "description": "Called as the source text is edited."
    },
    {
      "name": "autoAccept",
      "type": "number",
      "required": false,
      "defaultValue": "0.85",
      "description": "Findings at or above this are marked for redaction to begin with; below it they wait for review."
    },
    {
      "name": "defaultStyle",
      "type": "RedactorStyle",
      "required": false,
      "defaultValue": "'label'",
      "description": "`[REDACTED:email]` or a same-length mask."
    },
    {
      "name": "onRedactedChange",
      "type": "(text: string, findings: RedactorFinding[]) => void",
      "required": false,
      "description": "Called with the redacted text whenever it changes."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
