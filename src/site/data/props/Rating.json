{
  "props": [
    {
      "name": "value",
      "type": "number",
      "required": true
    },
    {
      "name": "onValueChange",
      "type": "(value: number) => void",
      "required": false
    },
    {
      "name": "max",
      "type": "number",
      "required": false,
      "defaultValue": "5",
      "description": "Number of stars."
    },
    {
      "name": "size",
      "type": "RatingSize",
      "required": false,
      "defaultValue": "'md'",
      "description": "Star size: 16, 20 or 28px."
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Accessible name for the control."
    },
    {
      "name": "readOnly",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Display only. Renders as an image with a text alternative."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Blocks interaction and dims the control."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
