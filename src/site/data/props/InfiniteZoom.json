{
  "props": [
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Accessible name of the view."
    },
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "description": "`InfiniteZoomScene`s, outermost first."
    },
    {
      "name": "autoplay",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Dive on its own when it first appears. Ignored under reduced motion."
    },
    {
      "name": "speed",
      "type": "number",
      "required": false,
      "defaultValue": "0.12",
      "description": "Scenes per second while diving."
    },
    {
      "name": "paused",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Freeze the camera."
    },
    {
      "name": "controls",
      "type": "boolean",
      "required": false,
      "defaultValue": "true",
      "description": "Show the depth indicator, scrub bar and buttons."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins. Give it a height or an aspect ratio."
    }
  ]
}
