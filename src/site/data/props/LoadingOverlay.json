{
  "props": [
    {
      "name": "active",
      "type": "boolean",
      "required": true,
      "description": "Whether the overlay is showing."
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "defaultValue": "'Loading'",
      "description": "Announced while busy, and shown beside the spinner when visible is set."
    },
    {
      "name": "showLabel",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Show the label under the spinner."
    },
    {
      "name": "blur",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Blur the content behind the scrim."
    },
    {
      "name": "className",
      "type": "string",
      "required": false,
      "description": "Merged last, so it wins."
    }
  ]
}
