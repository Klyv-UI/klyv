{
  "name": "klyvui",
  "version": "1.0.0",
  "type": "module",
  "description": "An accent-led React component library. 614 accessible components that take their entire personality from a single colour.",
  "license": "MIT",
  "homepage": "https://klyvui.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Klyv-UI/klyv.git"
  },
  "bugs": {
    "url": "https://github.com/Klyv-UI/klyv/issues"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "tailwind",
    "accessible",
    "theming"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./types/css.d.ts",
      "default": "./dist/klyv.css"
    },
    "./preset.css": {
      "types": "./types/css.d.ts",
      "default": "./src/styles/preset.css"
    },
    "./tokens.css": {
      "types": "./types/css.d.ts",
      "default": "./src/styles/tokens.css"
    },
    "./package.json": "./package.json",
    "./tokens.json": "./dist/tokens.json"
  },
  "bin": {
    "klyvui": "cli/klyv.mjs",
    "klyvui-mcp": "mcp/server.mjs"
  },
  "files": [
    "dist",
    "src/components",
    "src/lib",
    "src/styles",
    "src/theme",
    "src/tokens",
    "src/index.ts",
    "src/site/blocks",
    "cli",
    "types",
    "data",
    "mcp",
    "skills",
    "LICENSE"
  ],
  "scripts": {
    "generate": "node scripts/generate-metadata.mjs && node scripts/generate-props.mjs && node scripts/generate-blocks.mjs && node scripts/generate-mcp-docs.mjs && node scripts/generate-evidence.mjs && node scripts/generate-seo.mjs && node scripts/client-directives.mjs --check && node scripts/check-rules.mjs",
    "predev": "npm run generate",
    "dev": "vite",
    "prebuild": "npm run generate",
    "build": "tsc -b && vite build",
    "build:lib": "npm run generate && npm run build:js && npm run build:types && npm run build:css && node scripts/measure-size.mjs && node scripts/export-tokens.mjs",
    "build:js": "vite build --config vite.lib.config.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build:css": "vite build --config vite.css.config.ts",
    "prepack": "npm run build:lib",
    "preview": "vite preview --outDir dist-site --port 4173",
    "lint": "tsc -b --noEmit",
    "check:preset": "node scripts/check-preset.mjs",
    "klyvui": "node cli/klyv.mjs",
    "directives": "node scripts/client-directives.mjs",
    "rules": "node scripts/check-rules.mjs",
    "test:a11y": "vitest run test/a11y --reporter=dot",
    "mcp": "node mcp/server.mjs",
    "test:mcp": "node --test test/mcp.test.mjs",
    "test:interaction": "vitest run test/interaction --reporter=dot",
    "test:platform": "vitest run test/platform --reporter=dot",
    "test": "npm run check:preset && npm run test:interaction && npm run test:platform && npm run test:a11y && npm run test:mcp",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
